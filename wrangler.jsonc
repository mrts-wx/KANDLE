{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kandle",
  "main": "worker.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  }
}
